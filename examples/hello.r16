description=a bouncing square, and the smallest cart that moves
__code__
// hello: no globals, no assets, just frames.
// esc quits, f11 toggles fullscreen.

fn on_init() {
    system::seed(1);
}

fn on_update(dt) {
    // dt is always 1/60; this cart derives its motion from the frame counter
}

fn on_draw() {
    gfx::clear(0);

    let t = system::frames();
    let x = (t * 2) % 288;
    let y = 96 + (t * 2) % 128;

    gfx::rect_filled(x, y, 16, 16, 9);
    gfx::rect(x, y, 16, 16, 5);
    gfx::text("RICO-16", 8, 8, 5);
    gfx::text("320X240 / 256 COLOURS", 8, 24, 3);
}
